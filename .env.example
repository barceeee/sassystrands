# Copy to .env.local. Both values are public (browser) settings from
# Supabase Dashboard → Project Settings → API.
VITE_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Only for `npm run create-owner` (never prefix with VITE_, never commit).
# Dashboard → Project Settings → API Keys → secret / service_role key.
SUPABASE_SERVICE_ROLE_KEY=
